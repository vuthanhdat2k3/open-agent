# RAG Service — environment configuration
# All variables are prefixed with RAG_ (except OPENAI_API_KEY which is also read).

# Runtime environment
RAG_ENV=development
RAG_LOG_LEVEL=INFO

# Admin REST API auth — leave empty to disable (local / trusted network only)
RAG_API_KEY=

# Server ports
RAG_REST_PORT=8100
RAG_MCP_PORT=8101
# MCP transport: "stdio" | "sse" | "both"
RAG_MCP_TRANSPORT=both

# Database (SQLite by default — no external service required)
RAG_DB_URL=sqlite+aiosqlite:///./rag.db

# Data / persistence directories
RAG_DATA_DIR=./data

# Embedder — "openai" | "ollama" | "sentence_transformers" | "simple"
# With no OPENAI_API_KEY the factory auto-falls back to an in-memory local
# embedder, so the service runs fully offline.
RAG_EMBEDDER=openai
OPENAI_API_KEY=sk-...
RAG_OPENAI_EMBED_MODEL=text-embedding-3-small

# Vector store — "qdrant" | "chroma" | "memory"
RAG_VECTOR_STORE=qdrant
RAG_QDRANT_URL=http://localhost:6333

# BM25 backend — "memory" | "redis"
RAG_BM25_BACKEND=memory
RAG_BM25_TOKENIZER=whitespace

# Retrieval fusion
RAG_RRF_K=60
RAG_DEFAULT_TOP_K=5
RAG_DEFAULT_CANDIDATE_K=50

# Optional knowledge-graph retrieval (LightRAG-style) — disabled by default
RAG_ENABLE_GRAPH=false
