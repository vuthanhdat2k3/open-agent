# Build context exclusions for the RAG service image.
.git
.gitignore

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Runtime state (generated on first run)
rag.db
data/

# Secrets / local config
.env
.env.*
!.env.example

# Logs
*.log
boot.log
boot.err

# Docs are not needed at runtime
docs/
