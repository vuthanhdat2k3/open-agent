# ============================================================================
# OpenAgent — backend environment
# Copy to `.env` and fill values. Read via pydantic-settings (OPENAGENT_*).
# ============================================================================

# ---- Server ----
OPENAGENT_HOST=127.0.0.1
OPENAGENT_PORT=8000
OPENAGENT_CORS_ORIGINS=http://localhost:3000

# ---- Database (async). ----
OPENAGENT_DB_URL=postgresql+asyncpg://postgres.dkzfrzwevnyzhcicmtda:openagent%4019052003@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ---- Security ----
# API key required for non-localhost access. Empty => localhost-only mode.
OPENAGENT_API_KEY=

# ---- Default LLM provider (OpenAI-compatible) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ---- Workflow engine ----
OPENAGENT_MAX_AGENT_DEPTH=5
OPENAGENT_MAX_ITERATIONS=12
OPENAGENT_LOOP_WARN=3
OPENAGENT_LOOP_BLOCK=5
OPENAGENT_LOOP_CIRCUIT=30

# ---- Logging ----
OPENAGENT_LOG_LEVEL=INFO
