GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
# Optional: use a service-account JSON instead of browser OAuth (headless deployments)
# GOOGLE_SERVICE_ACCOUNT_PATH=service-account.json
# Optional: restrict every operation to a single Drive folder
# DRIVE_ROOT_FOLDER_ID=
# Tuning
DRIVE_PAGE_SIZE=20
DRIVE_MAX_OUTPUT_CHARS=40000
