OPENAGENT_DB_URL=postgresql+asyncpg://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
# Local Postgres service (docker-compose.yml `postgres`) used when
# OPENAGENT_DB_URL points at it instead of a managed/external database.
OPENAGENT_POSTGRES_USER=openagent
OPENAGENT_POSTGRES_PASSWORD=change-me-to-a-random-secret
OPENAGENT_POSTGRES_DB=openagent
OPENAGENT_REDIS_URL=redis://redis:6379/0
OPENAGENT_WORKFLOW_EXECUTION_MODE=inline
OPENAGENT_JWT_SECRET_KEY=change-me-to-a-random-32-byte-secret
# Bearer token securing the self-hosted crawl4ai instance (web_fetch's JS-rendering
# crawler) - required so it isn't reachable unauthenticated on the compose network.
CRAWLER_API_TOKEN=change-me-to-a-random-32-byte-secret
# YouTube Data API v3 key for the youtube_search tool (console.cloud.google.com,
# enable "YouTube Data API v3", create an API key). Empty disables the tool.
OPENAGENT_YOUTUBE_API_KEY=
OPENAGENT_COOKIE_SECURE=false
OPENAGENT_OTEL_ENABLED=false
OPENAGENT_OTEL_EXPORTER_ENDPOINT=
OPENAGENT_OBSERVABILITY_ENABLED=false
OPENAGENT_OBSERVABILITY_CAPTURE_CONTENT=true
OPENAGENT_OBSERVABILITY_SAMPLING_RATE=1.0
OPENAGENT_OBSERVABILITY_MAX_CONTENT_BYTES=2097152
OPENAGENT_LANGFUSE_ENABLED=false
OPENAGENT_LANGFUSE_PUBLIC_KEY=pk-lf-change-me
OPENAGENT_LANGFUSE_SECRET_KEY=sk-lf-change-me
OPENAGENT_LANGFUSE_BASE_URL=http://langfuse-web:3000
OPENAGENT_LANGFUSE_FLUSH_TIMEOUT_SECONDS=5

# Langfuse self-hosted profile (`docker compose --profile langfuse ...`).
LANGFUSE_DATABASE_URL=postgresql://langfuse:change-me-langfuse-postgres-password@langfuse-postgres:5432/langfuse
LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=change-me-langfuse-postgres-password
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_CLICKHOUSE_USER=langfuse
LANGFUSE_CLICKHOUSE_PASSWORD=change-me-langfuse-clickhouse-password
LANGFUSE_REDIS_AUTH=change-me-langfuse-redis-password
LANGFUSE_NEXTAUTH_SECRET=change-me-to-a-random-32-byte-secret
LANGFUSE_SALT=change-me-to-a-random-salt
LANGFUSE_ENCRYPTION_KEY=change-me-to-a-random-64-char-hex-key
LANGFUSE_INIT_ORG_ID=openagent
LANGFUSE_INIT_ORG_NAME=OpenAgent
LANGFUSE_INIT_PROJECT_ID=openagent
LANGFUSE_INIT_PROJECT_NAME=OpenAgent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-change-me
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=OpenAgent Admin
LANGFUSE_INIT_USER_PASSWORD=change-me-to-a-strong-password
API_INTERNAL_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Customer Intelligence MCP/OAuth
OPENAGENT_CUSTOMER_INTELLIGENCE_ENABLED=false
OPENAGENT_CI_MCP_URL=http://customer-intelligence-mcp:8301/sse
OPENAGENT_CI_GOOGLE_OAUTH_CLIENT_ID=
OPENAGENT_CI_GOOGLE_OAUTH_CLIENT_SECRET=
OPENAGENT_CI_FRONTEND_REDIRECT_URL=http://localhost:3000/integrations
CI_COMPANY_API_URL=
CI_COMPANY_API_KEY=
